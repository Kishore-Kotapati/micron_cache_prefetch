# Generic gate-level synthesis of the cache + prefetch engine.
read_verilog -sv ../rtl/cache_controller.v ../rtl/tag_array.v ../rtl/cache_memory.v ../rtl/replacement_policy.v ../rtl/stride_predictor.v ../rtl/prefetch_engine.v synth_top.v
hierarchy -check -top synth_top
synth -top synth_top
tee -o synth_stats.txt stat
check -assert
write_verilog -noattr synth_netlist.v
